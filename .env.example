DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=clinica_terapia
PORT=3000
# Acesso admin/admin somente para desenvolvimento local; mantenha falso em produção.
NODE_ENV=development
DEV_LOGIN_ENABLED=false
AUTH_SECRET=generate-a-random-secret-with-at-least-64-characters-before-deploying
CORS_ORIGINS=https://portal.example.com
